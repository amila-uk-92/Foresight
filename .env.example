# Copy to .env; keep real keys outside source control and the browser.
OPENAI_API_KEY=
FORESIGHT_OPENAI_ENABLED=0
# Supported pinned model; its price assumptions are versioned in the adapter.
FORESIGHT_OPENAI_MODEL=gpt-4o-mini-2024-07-18
# Setup-only default. Explicitly change before a paid experiment.
FORESIGHT_OPENAI_MAX_EXPERIMENT_USD=0
FORESIGHT_OPENAI_TOTAL_CAP_USD=0
TYPESAFE_API_KEY=
FORESIGHT_JEV_ENABLED=0
FORESIGHT_JEV_MODEL=jev-1.13.0
